# Copy this file to .env and fill in real values. Never commit the real
# .env file to version control.

# Generate with: node hash-password.js "your chosen password"
ADMIN_PASSWORD_HASH=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on.
PORT=3000

# Set to "production" when actually deployed, so session cookies require
# HTTPS. Leave unset for local development over plain http://localhost.
NODE_ENV=

# If you host the frontend separately from this backend (e.g. the static
# site stays on GitHub Pages and only the API runs here), set this to
# that site's URL so CORS allows it. Leave unset to allow any origin,
# which is fine for local development but not for production.
SITE_ORIGIN=
